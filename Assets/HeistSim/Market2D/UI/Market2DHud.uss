/* Frischemarkt 2D Riso Editorial UI — Fullscreen Play HUD + Collapsible Shift Dossier.
   Sharp corners, 1.5px #344A80 ink rules, hard offset print shadows, #F3EBDD paper stock,
   #FBF6EC cards, strict overflow containment across every card, and Bayer dither bars. */

:root {
    --paper: #f3ebdd;
    --card: #fbf6ec;
    --ink: #344a80;
    --ink-2: #56628a;
    --line: rgba(52, 74, 128, 0.28);
    --coral: #ee6852;
    --coral-ink: #a8402d;
    --sun: #ffd428;
    --teal: #008c8a;
    --black: #242226;
}

.app-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    position: relative;
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Regular.ttf");
    color: var(--ink);
    font-size: 14px;
}

/* ---------------- Full-Width Isometric Viewport Overlay ---------------- */

.viewport-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
}

.shadow-wrap {
    position: relative;
    padding-right: 4px;
    padding-bottom: 4px;
}

.shadow-wrap-sm {
    position: relative;
    padding-right: 2px;
    padding-bottom: 2px;
}

.shadow-plate {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 0;
    bottom: 0;
    background-color: var(--ink);
}

.shadow-plate-sm {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 0;
    bottom: 0;
    background-color: var(--ink);
}

.shadow-plate-coral {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 0;
    bottom: 0;
    background-color: var(--coral);
}

.ink-box {
    background-color: var(--card);
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
}

/* Top-left compact live HUD pill */
.top-hud-wrap {
    position: absolute;
    left: 14px;
    top: 14px;
    max-width: 680px;
}

.top-hud {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 11px;
    overflow: hidden;
}

.top-hud-icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.top-hud-loot {
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    font-size: 13px;
    color: var(--ink);
    white-space: nowrap;
    flex-shrink: 0;
}

.top-hud-sep {
    width: 1px;
    height: 16px;
    background-color: var(--line);
    margin-left: 9px;
    margin-right: 9px;
    flex-shrink: 0;
}

.top-hud-mono {
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationMono-Regular.ttf");
    font-size: 12px;
    color: var(--ink);
    white-space: nowrap;
    flex-shrink: 0;
}

.top-hud-rf {
    background-color: var(--coral);
    color: var(--paper);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    font-size: 10px;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 5px;
    padding-right: 5px;
    margin-left: 6px;
    white-space: nowrap;
    flex-shrink: 0;
}

.top-hud-kicker {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--ink-2);
    margin-right: 5px;
    white-space: nowrap;
    flex-shrink: 0;
}

.top-mini-track {
    width: 54px;
    height: 9px;
    background-color: var(--paper);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    flex-shrink: 0;
    overflow: hidden;
}

.top-mini-track-heat {
    width: 58px;
}

.top-mini-fill-sun {
    height: 100%;
    width: 100%;
    background-color: var(--teal);
}

.top-mini-fill-winded {
    background-color: var(--coral);
}

.top-mini-fill-coral {
    height: 100%;
    width: 12%;
    background-color: var(--coral);
    background-image: url("project://database/Assets/HeistSim/Market2D/Sprites/UI/dither_coral.png");
    background-repeat: repeat repeat;
    background-size: 8px 8px;
}

.top-hud-dot {
    margin-right: 5px;
}

.top-hud-alert {
    font-size: 11px;
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    color: var(--ink);
    margin-right: 6px;
    min-width: 46px;
    white-space: nowrap;
    flex-shrink: 0;
}

/* Top-right Dossier Drawer Toggle */
.drawer-toggle-wrap {
    position: absolute;
    right: 14px;
    top: 14px;
}

.drawer-toggle-btn {
    flex-direction: row;
    align-items: center;
    height: 34px;
    background-color: var(--card);
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    font-size: 12px;
    letter-spacing: 0.8px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 9px;
    padding-right: 10px;
}

.drawer-toggle-btn:hover {
    background-color: var(--sun);
}

.drawer-toggle-btn:active {
    translate: 1px 1px;
}

.drawer-toggle-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.drawer-toggle-label {
    font-size: 12px;
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    white-space: nowrap;
}

.drawer-unread-dot {
    width: 7px;
    height: 7px;
    margin-left: 6px;
    background-color: var(--coral);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    flex-shrink: 0;
}

/* Bottom-left department pill */
.zone-pill-wrap {
    position: absolute;
    left: 14px;
    bottom: 14px;
    max-width: 300px;
}

.zone-pill {
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 12px;
    overflow: hidden;
}

.zone-pill-kicker {
    font-size: 9px;
    color: var(--ink-2);
    letter-spacing: 2px;
    margin-bottom: 1px;
}

.zone-pill-name {
    font-size: 13px;
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Bottom-right zoom buttons */
.zoom-group {
    position: absolute;
    right: 14px;
    bottom: 14px;
    flex-direction: row;
}

.zoom-group-shifted {
    right: 394px;
}

.zoom-btn-wrap {
    margin-left: 8px;
}

.zoom-btn {
    width: 40px;
    height: 40px;
    background-color: var(--card);
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    font-size: 18px;
    -unity-text-align: middle-center;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin: 0;
    padding: 0;
}

.zoom-btn-fit {
    width: 50px;
    font-size: 12px;
    letter-spacing: 1px;
}

.zoom-btn:hover {
    background-color: var(--sun);
}

.zoom-btn:active {
    translate: 2px 2px;
}

.zoom-readout {
    height: 40px;
    min-width: 50px;
    background-color: var(--paper);
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationMono-Regular.ttf");
    font-size: 12px;
    -unity-text-align: middle-center;
    padding-left: 6px;
    padding-right: 6px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
}

.zoom-btn-sfx {
    width: 48px;
    font-size: 11px;
    letter-spacing: 1px;
}

.zoom-btn-muted {
    background-color: var(--paper);
    color: var(--ink-2);
}

/* Bottom-center contextual prompt, channel bar, and refusal */
.prompt-stack {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    align-items: center;
}

.prompt-stack-shifted {
    right: 380px;
}

.refusal-banner {
    background-color: var(--card);
    max-width: 440px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--coral-ink);
    border-right-color: var(--coral-ink);
    border-bottom-color: var(--coral-ink);
    border-left-color: var(--coral-ink);
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 8px;
}

.refusal-text {
    color: var(--coral-ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    font-size: 13px;
    letter-spacing: 0.6px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.prompt-card {
    flex-direction: column;
    min-width: 240px;
    max-width: 460px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 14px;
    overflow: hidden;
}

.prompt-row {
    flex-direction: row;
    align-items: center;
}

.prompt-key {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    background-color: var(--sun);
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-right: 10px;
}

.prompt-label {
    font-size: 13px;
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0px;
    white-space: normal;
}

.channel-track {
    height: 10px;
    margin-top: 7px;
    background-color: var(--paper);
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
}

.channel-fill {
    height: 100%;
    width: 0%;
    background-color: var(--sun);
    background-image: url("project://database/Assets/HeistSim/Market2D/Sprites/UI/dither_sun.png");
    background-repeat: repeat repeat;
    background-size: 8px 8px;
}

/* Outcome receipt modal */
.outcome-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(243, 235, 221, 0.55);
}

.outcome-card {
    width: 360px;
    padding: 20px 22px;
}

.outcome-kicker {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--coral-ink);
    margin-bottom: 4px;
}

.outcome-title {
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSerif-Bold.ttf");
    font-size: 32px;
    color: var(--ink);
    margin-bottom: 6px;
}

.outcome-sub {
    font-size: 14px;
    color: var(--ink-2);
    white-space: normal;
}

/* ---------------- Collapsible Right Shift Dossier Drawer (380px) ---------------- */

.side-panel {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 380px;
    background-color: var(--paper);
    border-left-width: 2.5px;
    border-left-color: var(--ink);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 13px;
    padding-right: 13px;
    flex-direction: column;
    overflow: hidden;
}

.drawer-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 6px;
    margin-bottom: 6px;
    border-bottom-width: 1.5px;
    border-bottom-color: var(--line);
    flex-shrink: 0;
}

.drawer-title-col {
    flex-direction: column;
    flex-shrink: 1;
    min-width: 0px;
}

.drawer-kicker {
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--coral-ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
}

.display-title {
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSerif-Regular.ttf");
    font-size: 22px;
    color: var(--ink);
    margin: 0;
    padding: 0;
    letter-spacing: -0.5px;
}

.drawer-close-btn {
    height: 26px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 10px;
    padding-right: 10px;
    background-color: var(--card);
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    font-size: 11px;
    letter-spacing: 0.6px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    flex-shrink: 0;
    margin: 0;
}

.drawer-close-btn:hover {
    background-color: var(--sun);
}

.drawer-close-btn:active {
    translate: 1px 1px;
}

.drawer-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.drawer-card-wrap {
    margin-bottom: 6px;
    flex-shrink: 0;
}

/* Shift Summary Card */
.brief-card {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 11px;
    padding-right: 11px;
    overflow: hidden;
}

.brief-top {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 5px;
}

.loot-group {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 1;
    min-width: 0px;
}

.loot-big {
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSerif-Bold.ttf");
    font-size: 25px;
    color: var(--ink);
    margin-right: 6px;
}

.loot-quota {
    font-size: 12px;
    color: var(--ink-2);
    margin-bottom: 2px;
}

.guard-chip {
    flex-direction: row;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: var(--paper);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    flex-shrink: 0;
}

.guard-dot {
    width: 8px;
    height: 8px;
    background-color: var(--teal);
    margin-right: 5px;
    flex-shrink: 0;
}

.guard-dot-warn {
    background-color: var(--sun);
}

.guard-dot-alert {
    background-color: var(--coral);
}

.guard-chip-text {
    font-size: 11px;
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    white-space: nowrap;
}

/* Strict 2x2 Stat Grid with zero horizontal overflow */
.stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 3px;
}

.stat-cell {
    width: 48.5%;
    min-width: 0px;
    overflow: hidden;
    background-color: var(--paper);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--line);
    border-right-color: var(--line);
    border-bottom-color: var(--line);
    border-left-color: var(--line);
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    margin-bottom: 4px;
}

.stat-value {
    font-size: 14px;
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0px;
}

.stat-value-alert {
    color: var(--coral-ink);
}

.stat-sub {
    font-size: 10px;
    color: var(--ink-2);
    margin-top: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0px;
}

/* Bayer-dithered Heat Bar */
.heat-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
}

.heat-title {
    font-size: 11px;
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
}

.heat-tier-label {
    font-size: 11px;
    color: var(--coral-ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
}

.dither-bar {
    height: 11px;
    background-color: var(--paper);
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    overflow: hidden;
}

.dither-bar-fill {
    height: 100%;
    width: 12%;
    background-color: var(--coral);
    background-image: url("project://database/Assets/HeistSim/Market2D/Sprites/UI/dither_coral.png");
    background-repeat: repeat repeat;
    background-size: 8px 8px;
}

/* Security Squad Intel Card */
.squad-card {
    padding-top: 5px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    overflow: hidden;
}

.squad-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.section-kicker {
    font-size: 10px;
    letter-spacing: 1.6px;
    color: var(--ink-2);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
}

.squad-arch-pill {
    font-size: 10px;
    color: var(--ink);
    background-color: var(--paper);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationMono-Regular.ttf");
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 5px;
    padding-right: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--line);
    border-right-color: var(--line);
    border-bottom-color: var(--line);
    border-left-color: var(--line);
}

.guard-trace-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--paper);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--line);
    border-right-color: var(--line);
    border-bottom-color: var(--line);
    border-left-color: var(--line);
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 7px;
    padding-right: 7px;
    margin-bottom: 3px;
    overflow: hidden;
}

.role-badge-icon {
    width: 15px;
    height: 15px;
    margin-right: 5px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.guard-tag-pill {
    font-size: 10px;
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationMono-Regular.ttf");
    color: var(--ink-2);
    margin-right: 6px;
    flex-shrink: 0;
}

.guard-ai-line {
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationMono-Regular.ttf");
    font-size: 11px;
    color: var(--ink);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Even 3-column Simulation Controls (exact 100% flex fit, zero overflow) */
.cta-row {
    flex-direction: row;
    margin-top: 4px;
}

.cta-wrap-eq {
    flex-grow: 1;
    flex-basis: 0px;
    min-width: 0px;
    position: relative;
    padding-right: 2px;
    padding-bottom: 2px;
    margin-right: 6px;
}

.cta-wrap-eq-last {
    margin-right: 0;
}

.cta-btn {
    height: 29px;
    background-color: var(--ink);
    color: var(--paper);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    font-size: 11px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin: 0;
    padding-left: 5px;
    padding-right: 5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cta-btn:hover {
    background-color: var(--coral-ink);
    border-top-color: var(--coral-ink);
    border-right-color: var(--coral-ink);
    border-bottom-color: var(--coral-ink);
    border-left-color: var(--coral-ink);
}

.cta-btn:active {
    translate: 1px 1px;
}

.cta-btn-trait {
    background-color: var(--sun);
    color: var(--ink);
}

.cta-btn-sec {
    background-color: var(--teal);
}

.cta-btn-sec:hover {
    background-color: var(--sun);
    color: var(--ink);
}

/* Objectives Card */
.obj-card {
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
}

.obj-list {
    flex-direction: column;
}

.obj-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.obj-row-last {
    margin-bottom: 0;
}

.obj-box {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
    background-color: var(--paper);
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    margin-right: 7px;
}

.obj-box-done {
    background-color: var(--teal);
    border-top-color: var(--teal);
    border-right-color: var(--teal);
    border-bottom-color: var(--teal);
    border-left-color: var(--teal);
}

.obj-text {
    font-size: 11px;
    color: var(--ink);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0px;
    white-space: normal;
}

.obj-text-done {
    color: var(--ink-2);
}

/* 12-Room Floorplan Minimap Card */
.map-card {
    padding: 5px 9px;
}

.map-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
}

.map-hint {
    font-size: 9px;
    color: var(--ink-2);
}

.minimap-board {
    position: relative;
    width: 100%;
    height: 78px;
    background-color: var(--paper);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
}

.minimap-row {
    flex-direction: row;
    flex-grow: 1;
}

.minimap-cell {
    flex-grow: 1;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-right-color: var(--line);
    border-bottom-color: var(--line);
    padding: 3px 4px;
}

.minimap-cell:hover {
    background-color: rgba(0, 140, 138, 0.16);
}

.minimap-cell-has-loot {
    border-bottom-width: 2.5px;
    border-bottom-color: var(--sun);
}

.minimap-cell-active {
    background-color: rgba(255, 212, 40, 0.42);
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
}

.minimap-cell-label {
    font-size: 9px;
    color: var(--ink-2);
}

.minimap-pip {
    position: absolute;
    width: 8px;
    height: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
}

.pip-player { background-color: var(--teal); width: 9px; height: 9px; }
.pip-guard { background-color: var(--coral); width: 9px; height: 9px; }
.pip-guard2 { background-color: var(--coral-ink); width: 9px; height: 9px; }
.pip-staff { background-color: var(--sun); width: 7px; height: 7px; }
.pip-exit { background-color: var(--card); border-top-color: var(--coral-ink); border-right-color: var(--coral-ink); border-bottom-color: var(--coral-ink); border-left-color: var(--coral-ink); width: 9px; height: 9px; }

.map-legend-row {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}

.legend-swatch {
    width: 7px;
    height: 7px;
    margin-right: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    flex-shrink: 0;
}

.legend-player { background-color: var(--teal); }
.legend-guard { background-color: var(--coral); }
.legend-guard2 { background-color: var(--coral-ink); }
.legend-staff { background-color: var(--sun); }
.legend-exit { background-color: var(--card); border-top-color: var(--coral-ink); border-right-color: var(--coral-ink); border-bottom-color: var(--coral-ink); border-left-color: var(--coral-ink); }

.legend-label {
    font-size: 9px;
    color: var(--ink-2);
    margin-right: 9px;
}

/* Shift Journal + Controls Card */
.journal-card {
    padding-top: 5px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    overflow: hidden;
}

.log-row {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    min-height: 16px;
    margin-top: 3px;
}

.log-tag {
    width: 48px;
    flex-shrink: 0;
    font-size: 9px;
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    color: var(--ink);
    background-color: var(--paper);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--line);
    border-right-color: var(--line);
    border-bottom-color: var(--line);
    border-left-color: var(--line);
    -unity-text-align: middle-center;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-right: 7px;
}

.log-tag-alarm {
    color: var(--paper);
    background-color: var(--coral-ink);
    border-top-color: var(--coral-ink);
    border-right-color: var(--coral-ink);
    border-bottom-color: var(--coral-ink);
    border-left-color: var(--coral-ink);
}

.log-msg {
    font-size: 11px;
    color: var(--ink);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0px;
    white-space: normal;
}

.controls-kicker {
    font-size: 9px;
    letter-spacing: 1.4px;
    color: var(--ink-2);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    margin-top: 5px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.controls-text {
    font-size: 10px;
    color: var(--ink-2);
    margin-top: 2px;
    white-space: normal;
}

/* Alert edge flash frame */
.alert-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: var(--coral);
    border-right-color: var(--coral);
    border-bottom-color: var(--coral);
    border-left-color: var(--coral);
    background-color: rgba(238, 104, 82, 0.06);
}

/* Floating world-projected popups (+€58, FLANKING!) */
.popup-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.float-popup {
    position: absolute;
    background-color: var(--sun);
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    font-size: 13px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 7px;
    padding-right: 7px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
}

.float-popup-rf {
    background-color: var(--coral);
    color: var(--card);
}

/* Off-screen next-objective compass pill */
.compass-pill {
    position: absolute;
    flex-direction: row;
    align-items: center;
    background-color: var(--card);
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 7px;
    padding-right: 8px;
}

.compass-arrow {
    background-color: var(--sun);
    color: var(--ink);
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    font-size: 12px;
    padding-left: 4px;
    padding-right: 4px;
    margin-right: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink);
    border-right-color: var(--ink);
    border-bottom-color: var(--ink);
    border-left-color: var(--ink);
}

.compass-label {
    font-size: 11px;
    -unity-font: url("project://database/Assets/HeistSim/Market2D/UI/Fonts/LiberationSans-Bold.ttf");
    color: var(--ink);
}

.is-hidden {
    display: none;
}

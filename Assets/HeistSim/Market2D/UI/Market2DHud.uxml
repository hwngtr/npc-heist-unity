<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Market2DHud.uss" />
    <ui:VisualElement name="app-root" class="app-root" picking-mode="Ignore">

        <!-- Full-Width Isometric Viewport Overlay -->
        <ui:VisualElement name="viewport-overlay" class="viewport-overlay" picking-mode="Ignore">

            <!-- Calm breathing / edge flash coral alert frame -->
            <ui:VisualElement name="alert-vignette" class="alert-vignette is-hidden" picking-mode="Ignore" />

            <!-- Floating world-projected gain/callout badges (+€58, FLANKING!) -->
            <ui:VisualElement name="popup-layer" class="popup-layer" picking-mode="Ignore" />

            <!-- Off-screen next-objective directional compass pill -->
            <ui:VisualElement name="compass-pill" class="compass-pill is-hidden" picking-mode="Ignore">
                <ui:Label name="compass-arrow" text="→" class="compass-arrow" picking-mode="Ignore" />
                <ui:Label name="compass-label" text="€32 LOOT" class="compass-label" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Top-Left Minimalist Status Strip (fullscreen play HUD) -->
            <ui:VisualElement name="top-hud-strip" class="top-hud-wrap shadow-wrap-sm" picking-mode="Ignore">
                <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                <ui:VisualElement class="ink-box top-hud" picking-mode="Ignore">
                    <ui:VisualElement name="hud-bag-icon" class="top-hud-icon" picking-mode="Ignore" />
                    <ui:Label name="hud-loot-pill" text="€0 / €190" class="top-hud-loot" picking-mode="Ignore" />
                    <ui:VisualElement class="top-hud-sep" picking-mode="Ignore" />
                    <ui:Label name="hud-bag-pill" text="0/6" class="top-hud-mono" picking-mode="Ignore" />
                    <ui:Label name="hud-rf-pill" text="0 RF" class="top-hud-rf is-hidden" picking-mode="Ignore" />
                    <ui:VisualElement class="top-hud-sep" picking-mode="Ignore" />
                    <ui:Label text="STAM" class="top-hud-kicker" picking-mode="Ignore" />
                    <ui:VisualElement name="hud-stam-track" class="top-mini-track" picking-mode="Ignore">
                        <ui:VisualElement name="hud-stam-fill" class="top-mini-fill-sun" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="top-hud-sep" picking-mode="Ignore" />
                    <ui:VisualElement name="hud-alert-dot" class="guard-dot top-hud-dot" picking-mode="Ignore" />
                    <ui:Label name="hud-alert-label" text="CALM" class="top-hud-alert" picking-mode="Ignore" />
                    <ui:VisualElement class="top-mini-track top-mini-track-heat" picking-mode="Ignore">
                        <ui:VisualElement name="hud-heat-fill" class="top-mini-fill-coral" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Top-Right Drawer Toggle Button -->
            <ui:VisualElement name="drawer-toggle-wrap" class="drawer-toggle-wrap shadow-wrap-sm">
                <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                <ui:Button name="btn-toggle-drawer" class="drawer-toggle-btn">
                    <ui:VisualElement name="drawer-toggle-icon" class="drawer-toggle-icon" picking-mode="Ignore" />
                    <ui:Label name="drawer-toggle-label" text="BRIEF [I]" class="drawer-toggle-label" picking-mode="Ignore" />
                    <ui:VisualElement name="drawer-unread-dot" class="drawer-unread-dot is-hidden" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>

            <!-- Bottom-Left Current Department Pill -->
            <ui:VisualElement class="zone-pill-wrap shadow-wrap-sm" picking-mode="Ignore">
                <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                <ui:VisualElement class="ink-box zone-pill" picking-mode="Ignore">
                    <ui:Label text="CURRENT DEPARTMENT" class="zone-pill-kicker" picking-mode="Ignore" />
                    <ui:Label name="zone-name" text="Entrance · Obst &amp; Gemüse · Pfand" class="zone-pill-name" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Bottom-Center Contextual Action Prompt + Channel Bar + Refusal -->
            <ui:VisualElement name="prompt-stack" class="prompt-stack" picking-mode="Ignore">
                <ui:VisualElement name="refusal-banner" class="refusal-banner is-hidden" picking-mode="Ignore">
                    <ui:Label name="refusal-text" text="BAG FULL" class="refusal-text" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement name="prompt-wrap" class="shadow-wrap-sm is-hidden" picking-mode="Ignore">
                    <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                    <ui:VisualElement class="ink-box prompt-card" picking-mode="Ignore">
                        <ui:VisualElement class="prompt-row" picking-mode="Ignore">
                            <ui:Label text="E" class="prompt-key" picking-mode="Ignore" />
                            <ui:Label name="prompt-label" text="Hold E · Steal item" class="prompt-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="channel-track" class="channel-track is-hidden" picking-mode="Ignore">
                            <ui:VisualElement name="channel-fill" class="channel-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Bottom-Right Zoom + SFX Controls -->
            <ui:VisualElement name="zoom-group" class="zoom-group" picking-mode="Ignore">
                <ui:VisualElement class="zoom-btn-wrap shadow-wrap-sm">
                    <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                    <ui:Button name="btn-mute" text="SFX" class="zoom-btn zoom-btn-sfx" />
                </ui:VisualElement>
                <ui:VisualElement class="zoom-btn-wrap shadow-wrap-sm" picking-mode="Ignore">
                    <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                    <ui:Label name="zoom-readout" text="100%" class="zoom-readout" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="zoom-btn-wrap shadow-wrap-sm">
                    <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                    <ui:Button name="btn-zoom-in" text="+" class="zoom-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="zoom-btn-wrap shadow-wrap-sm">
                    <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                    <ui:Button name="btn-zoom-out" text="-" class="zoom-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="zoom-btn-wrap shadow-wrap-sm">
                    <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                    <ui:Button name="btn-zoom-fit" text="FIT" class="zoom-btn zoom-btn-fit" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Outcome Receipt Modal -->
            <ui:VisualElement name="outcome-overlay" class="outcome-overlay is-hidden" picking-mode="Ignore">
                <ui:VisualElement class="shadow-wrap">
                    <ui:VisualElement class="shadow-plate" picking-mode="Ignore" />
                    <ui:VisualElement class="ink-box outcome-card">
                        <ui:Label name="outcome-kicker" text="SHIFT RECEIPT" class="outcome-kicker" />
                        <ui:Label name="outcome-title" text="Escaped" class="outcome-title" />
                        <ui:Label name="outcome-sub" text="Press R or click Reset to run another heist." class="outcome-sub" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Collapsible Right Dossier Drawer (380px, hidden by default) -->
        <ui:VisualElement name="side-panel" class="side-panel is-hidden">

            <ui:VisualElement class="drawer-header">
                <ui:VisualElement class="drawer-title-col">
                    <ui:Label text="SHIFT DOSSIER" class="drawer-kicker" />
                    <ui:Label text="Frischemarkt" class="display-title" />
                </ui:VisualElement>
                <ui:Button name="btn-close-drawer" text="CLOSE [I]" class="drawer-close-btn" />
            </ui:VisualElement>

            <ui:ScrollView name="drawer-scroll" class="drawer-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">

                <!-- Card 1: Shift Summary & Store Suspicion -->
                <ui:VisualElement class="shadow-wrap drawer-card-wrap">
                    <ui:VisualElement class="shadow-plate" picking-mode="Ignore" />
                    <ui:VisualElement class="ink-box brief-card">

                        <ui:VisualElement class="brief-top">
                            <ui:VisualElement class="loot-group">
                                <ui:Label name="loot-big" text="€0" class="loot-big" />
                                <ui:Label name="loot-quota" text="of €190 quota" class="loot-quota" />
                            </ui:VisualElement>
                            <ui:VisualElement class="guard-chip">
                                <ui:VisualElement name="guard-dot" class="guard-dot" />
                                <ui:Label name="guard-chip-text" text="2G PATROL" class="guard-chip-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="stat-grid">
                            <ui:VisualElement class="stat-cell">
                                <ui:Label name="stat-bag" text="0 / 6" class="stat-value" />
                                <ui:Label name="stat-bag-sub" text="bag · 100% spd" class="stat-sub" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-cell">
                                <ui:Label name="stat-stamina" text="100%" class="stat-value" />
                                <ui:Label name="stat-stamina-sub" text="stamina" class="stat-sub" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-cell">
                                <ui:Label name="stat-tags" text="Clean" class="stat-value" />
                                <ui:Label text="RF security tags" class="stat-sub" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-cell">
                                <ui:Label name="stat-cctv" text="Online" class="stat-value" />
                                <ui:Label name="stat-radio" text="radio quiet" class="stat-sub" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="heat-header">
                            <ui:Label text="Store suspicion" class="heat-title" />
                            <ui:Label name="heat-tier-label" text="Calm (12%)" class="heat-tier-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="dither-bar">
                            <ui:VisualElement name="heat-fill" class="dither-bar-fill" />
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Card 2: Security Squad Intel & Simulation Controls -->
                <ui:VisualElement class="shadow-wrap-sm drawer-card-wrap">
                    <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                    <ui:VisualElement class="ink-box squad-card">
                        <ui:VisualElement class="squad-header">
                            <ui:Label text="SECURITY SQUAD" class="section-kicker" />
                            <ui:Label name="squad-arch-pill" text="ST+HTN" class="squad-arch-pill" />
                        </ui:VisualElement>

                        <ui:VisualElement name="g1-ai-row" class="guard-trace-row">
                            <ui:VisualElement name="g1-role-icon" class="role-badge-icon" />
                            <ui:Label text="G1" class="guard-tag-pill" />
                            <ui:Label name="g1-ai-line" text="PATROL · SectorPatrol" class="guard-ai-line" />
                        </ui:VisualElement>

                        <ui:VisualElement name="g2-ai-row" class="guard-trace-row">
                            <ui:VisualElement name="g2-role-icon" class="role-badge-icon" />
                            <ui:Label text="G2" class="guard-tag-pill" />
                            <ui:Label name="g2-ai-line" text="PATROL · SectorPatrol" class="guard-ai-line" />
                        </ui:VisualElement>

                        <ui:Label name="ai-trace-line" text="" class="is-hidden" />

                        <ui:VisualElement class="cta-row">
                            <ui:VisualElement class="cta-wrap-eq">
                                <ui:VisualElement class="shadow-plate-coral" picking-mode="Ignore" />
                                <ui:Button name="btn-switch-ai" text="ST+HTN [Tab]" class="cta-btn" />
                            </ui:VisualElement>
                            <ui:VisualElement class="cta-wrap-eq">
                                <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                                <ui:Button name="btn-trait" text="Standard [P]" class="cta-btn cta-btn-trait" />
                            </ui:VisualElement>
                            <ui:VisualElement class="cta-wrap-eq cta-wrap-eq-last">
                                <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                                <ui:Button name="btn-reset" text="Reset [R]" class="cta-btn cta-btn-sec" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Card 3: Objectives Checklist -->
                <ui:VisualElement class="shadow-wrap-sm drawer-card-wrap">
                    <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                    <ui:VisualElement class="ink-box obj-card">
                        <ui:VisualElement class="squad-header">
                            <ui:Label text="OBJECTIVES" class="section-kicker" />
                            <ui:Label name="obj-count" text="0 / 5" class="map-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement class="obj-list">
                            <ui:VisualElement class="obj-row">
                                <ui:VisualElement name="obj-box-0" class="obj-box" />
                                <ui:Label name="obj-text-0" text="Cut the CCTV power panel" class="obj-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="obj-row">
                                <ui:VisualElement name="obj-box-1" class="obj-box" />
                                <ui:Label name="obj-text-1" text="Force the spirits vitrine" class="obj-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="obj-row">
                                <ui:VisualElement name="obj-box-2" class="obj-box" />
                                <ui:Label name="obj-text-2" text="Bag €190 in goods" class="obj-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="obj-row">
                                <ui:VisualElement name="obj-box-3" class="obj-box" />
                                <ui:Label name="obj-text-3" text="De-tag all RF items" class="obj-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="obj-row obj-row-last">
                                <ui:VisualElement name="obj-box-4" class="obj-box" />
                                <ui:Label name="obj-text-4" text="Exit through the EAS gate" class="obj-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Card 4: 12-Room Interactive Floorplan -->
                <ui:VisualElement class="shadow-wrap-sm drawer-card-wrap">
                    <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                    <ui:VisualElement class="ink-box map-card">
                        <ui:VisualElement class="map-header-row">
                            <ui:Label text="STORE FLOORPLAN (12 DEPTS)" class="section-kicker" />
                            <ui:Label text="click room to scout" class="map-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement name="minimap-board" class="minimap-board">
                            <ui:VisualElement class="minimap-row">
                                <ui:VisualElement name="mm-r1" class="minimap-cell"><ui:Label text="ENTR" class="minimap-cell-label" /></ui:VisualElement>
                                <ui:VisualElement name="mm-r2" class="minimap-cell"><ui:Label text="BAKE" class="minimap-cell-label" /></ui:VisualElement>
                                <ui:VisualElement name="mm-r3" class="minimap-cell"><ui:Label text="DAIRY" class="minimap-cell-label" /></ui:VisualElement>
                                <ui:VisualElement name="mm-r7" class="minimap-cell"><ui:Label text="FLOR" class="minimap-cell-label" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="minimap-row">
                                <ui:VisualElement name="mm-r4" class="minimap-cell"><ui:Label text="DRINK" class="minimap-cell-label" /></ui:VisualElement>
                                <ui:VisualElement name="mm-r5" class="minimap-cell"><ui:Label text="FROZ" class="minimap-cell-label" /></ui:VisualElement>
                                <ui:VisualElement name="mm-r12" class="minimap-cell"><ui:Label text="STAFF" class="minimap-cell-label" /></ui:VisualElement>
                                <ui:VisualElement name="mm-r8" class="minimap-cell"><ui:Label text="BOH" class="minimap-cell-label" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="minimap-row">
                                <ui:VisualElement name="mm-r9" class="minimap-cell"><ui:Label text="BREAD" class="minimap-cell-label" /></ui:VisualElement>
                                <ui:VisualElement name="mm-r10" class="minimap-cell"><ui:Label text="DELI" class="minimap-cell-label" /></ui:VisualElement>
                                <ui:VisualElement name="mm-r11" class="minimap-cell"><ui:Label text="WINE" class="minimap-cell-label" /></ui:VisualElement>
                                <ui:VisualElement name="mm-r6" class="minimap-cell"><ui:Label text="EXIT" class="minimap-cell-label" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="pip-exit" class="minimap-pip pip-exit" picking-mode="Ignore" />
                            <ui:VisualElement name="pip-staff" class="minimap-pip pip-staff" picking-mode="Ignore" />
                            <ui:VisualElement name="pip-guard" class="minimap-pip pip-guard" picking-mode="Ignore" />
                            <ui:VisualElement name="pip-guard2" class="minimap-pip pip-guard2" picking-mode="Ignore" />
                            <ui:VisualElement name="pip-player" class="minimap-pip pip-player" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="map-legend-row">
                            <ui:VisualElement class="legend-swatch legend-player" /><ui:Label text="Thief" class="legend-label" />
                            <ui:VisualElement class="legend-swatch legend-guard" /><ui:Label text="G1" class="legend-label" />
                            <ui:VisualElement class="legend-swatch legend-guard2" /><ui:Label text="G2" class="legend-label" />
                            <ui:VisualElement class="legend-swatch legend-staff" /><ui:Label text="Staff" class="legend-label" />
                            <ui:VisualElement class="legend-swatch legend-exit" /><ui:Label text="Exit" class="legend-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Card 5: Shift Journal & Controls Reference -->
                <ui:VisualElement class="shadow-wrap-sm drawer-card-wrap">
                    <ui:VisualElement class="shadow-plate-sm" picking-mode="Ignore" />
                    <ui:VisualElement class="ink-box journal-card">
                        <ui:Label text="SHIFT JOURNAL" class="section-kicker" />
                        <ui:VisualElement name="log-container">
                            <ui:VisualElement name="log-row-0" class="log-row">
                                <ui:Label name="log-tag-0" text="START" class="log-tag" />
                                <ui:Label name="log-msg-0" text="Entered Frischemarkt via north-west portal" class="log-msg" />
                            </ui:VisualElement>
                            <ui:VisualElement name="log-row-1" class="log-row is-hidden">
                                <ui:Label name="log-tag-1" text="" class="log-tag" />
                                <ui:Label name="log-msg-1" text="" class="log-msg" />
                            </ui:VisualElement>
                            <ui:VisualElement name="log-row-2" class="log-row is-hidden">
                                <ui:Label name="log-tag-2" text="" class="log-tag" />
                                <ui:Label name="log-msg-2" text="" class="log-msg" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:Label text="CONTROLS" class="controls-kicker" />
                        <ui:Label text="WASD Move · E Steal/Act · C Crouch · Shift Sprint · Q Decoy · RMB Scout · I Dossier" class="controls-text" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:ScrollView>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
